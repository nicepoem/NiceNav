    "dexie": "^4.0.11",
    "element-plus": "^2.9.7",
    "pinia": "^3.0.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.13.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "sass": "^1.86.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.26.0",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.2.3",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  }
